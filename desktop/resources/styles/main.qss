/* ====================================
   客诉自动回复出单智能体 - 商务风主题
   版本：v2.1
   配色：深空黑 #1E2329 + 香槟金 #C9A86A
   ==================================== */

/* ===== 全局基础 ===== */
QWidget {
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 14px;
    color: #1E2329;
}

QMainWindow {
    background-color: #F7F8FA;
}

/* ===== 侧边栏 ===== */
#sidebar {
    background-color: #1E2329;
    border: none;
    min-width: 220px;
    max-width: 220px;
}

#sidebar_title {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 600;
    padding: 24px 20px 4px 20px;
    background-color: #1E2329;
    border: none;
    letter-spacing: 0.5px;
}

#sidebar_subtitle {
    color: #8A94A6;
    font-size: 11px;
    font-weight: 300;
    padding: 0px 20px 20px 20px;
    background-color: #1E2329;
    border: none;
    border-bottom: 1px solid #2A3038;
}

#nav_button {
    background-color: transparent;
    color: #8A94A6;
    border: none;
    border-left: 3px solid transparent;
    text-align: left;
    padding: 11px 20px;
    font-size: 14px;
    font-weight: 400;
    min-height: 44px;
}

#nav_button:hover {
    background-color: #262C34;
    color: #C8CDD6;
}

#nav_button[selected="true"] {
    background-color: rgba(201, 168, 106, 0.06);
    color: #C9A86A;
    border-left: 3px solid #C9A86A;
}

#nav_badge {
    background-color: #A8423A;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 1px 7px;
    font-size: 11px;
    font-weight: 600;
    min-width: 20px;
    min-height: 18px;
    max-height: 18px;
}

/* ===== 内容区 ===== */
#content_area {
    background-color: #F7F8FA;
    border: none;
}

#page_title {
    color: #1E2329;
    font-size: 20px;
    font-weight: 600;
    background-color: transparent;
}

#page_subtitle {
    color: #8A94A6;
    font-size: 13px;
    background-color: transparent;
}

/* ===== 后端警告 ===== */
#backend_warning {
    background-color: #FFF8E1;
    color: #C77D3C;
    border: 1px solid #FFE082;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 13px;
}

/* ===== 按钮 ===== */
QPushButton {
    background-color: #1E2329;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 500;
    min-height: 32px;
}

QPushButton:hover {
    background-color: #2A3038;
}

QPushButton:pressed {
    background-color: #151A1F;
}

QPushButton:disabled {
    background-color: #D0D5DD;
    color: #FFFFFF;
}

/* 香槟金按钮 */
QPushButton[gold="true"] {
    background-color: #C9A86A;
    color: #FFFFFF;
}

QPushButton[gold="true"]:hover {
    background-color: #B8944E;
}

QPushButton[gold="true"]:pressed {
    background-color: #A8884A;
}

/* 次按钮（白底描边） */
QPushButton[secondary="true"] {
    background-color: #FFFFFF;
    color: #5A6377;
    border: 1px solid #EAEDF2;
}

QPushButton[secondary="true"]:hover {
    border-color: #C9A86A;
    color: #A8884A;
}

QPushButton[secondary="true"]:pressed {
    background-color: #F7F8FA;
}

/* 危险按钮 */
QPushButton[danger="true"] {
    background-color: #A8423A;
    color: #FFFFFF;
}

QPushButton[danger="true"]:hover {
    background-color: #973A33;
}

/* 成功按钮 */
QPushButton[success="true"] {
    background-color: #3A7D5F;
    color: #FFFFFF;
}

QPushButton[success="true"]:hover {
    background-color: #336D52;
}

/* 警告按钮 */
QPushButton[warning="true"] {
    background-color: #C77D3C;
    color: #FFFFFF;
}

QPushButton[warning="true"]:hover {
    background-color: #B56E32;
}

/* ===== 输入框 ===== */
QLineEdit {
    border: 1px solid #DDE0E4;
    border-radius: 6px;
    padding: 8px 12px;
    background-color: #FFFFFF;
    color: #1E2329;
    font-size: 14px;
    min-height: 20px;
}

QLineEdit:focus {
    border: 1px solid #C9A86A;
    box-shadow: 0 0 0 2px rgba(201, 168, 106, 0.15);
}

QLineEdit:disabled {
    background-color: #F5F6FA;
    color: #8A94A6;
}

/* ===== 多行文本 ===== */
QTextEdit {
    border: 1px solid #DDE0E4;
    border-radius: 6px;
    padding: 8px 12px;
    background-color: #FFFFFF;
    color: #1E2329;
    font-size: 14px;
}

QTextEdit:focus {
    border: 1px solid #C9A86A;
}

/* ===== 下拉框 ===== */
QComboBox {
    border: 1px solid #DDE0E4;
    border-radius: 6px;
    padding: 8px 12px;
    background-color: #FFFFFF;
    color: #1E2329;
    min-height: 20px;
}

QComboBox:focus {
    border: 1px solid #C9A86A;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    border: 1px solid #DDE0E4;
    background-color: #FFFFFF;
    selection-background-color: rgba(201, 168, 106, 0.12);
    selection-color: #1E2329;
    padding: 4px 0;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    min-height: 28px;
}

/* ===== 表格 ===== */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #FAFBFC;
    border: 1px solid #EAEDF2;
    border-radius: 8px;
    gridline-color: #EAEDF2;
    selection-background-color: rgba(201, 168, 106, 0.10);
    selection-color: #1E2329;
}

QTableWidget::item {
    padding: 10px 14px;
    border-bottom: 1px solid #EAEDF2;
}

QTableWidget::item:selected {
    background-color: rgba(201, 168, 106, 0.10);
}

QHeaderView::section {
    background-color: #F0F2F5;
    color: #5A6377;
    font-weight: 500;
    padding: 11px 14px;
    border: none;
    border-bottom: 2px solid #C9A86A;
    font-size: 12px;
}

QTableWidget::item:hover {
    background-color: rgba(201, 168, 106, 0.04);
}

/* ===== 滚动条 ===== */
QScrollBar:vertical {
    background-color: #F7F8FA;
    width: 6px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #D0D5DD;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #B0B7C3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #F7F8FA;
    height: 6px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #D0D5DD;
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #B0B7C3;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ===== 标签 ===== */
QLabel[urgency="high"] {
    color: #A8423A;
    font-weight: 600;
}

QLabel[urgency="medium"] {
    color: #C77D3C;
    font-weight: 600;
}

QLabel[urgency="low"] {
    color: #3A7D5F;
    font-weight: 600;
}

/* ===== 状态栏 ===== */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #EAEDF2;
    color: #8A94A6;
    font-size: 12px;
    padding: 4px 8px;
}

/* ===== 菜单栏 ===== */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #EAEDF2;
    color: #1E2329;
}

QMenuBar::item:selected {
    background-color: rgba(201, 168, 106, 0.08);
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #EAEDF2;
    border-radius: 6px;
    padding: 4px 0;
    color: #1E2329;
}

QMenu::item {
    padding: 8px 24px;
    min-height: 28px;
}

QMenu::item:selected {
    background-color: rgba(201, 168, 106, 0.08);
}

QMenu::separator {
    height: 1px;
    background: #EAEDF2;
    margin: 4px 12px;
}

/* ===== Tab 控件 ===== */
QTabWidget::pane {
    border: 1px solid #EAEDF2;
    border-radius: 8px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background-color: #F7F8FA;
    color: #5A6377;
    padding: 8px 20px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
    border: 1px solid transparent;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #C9A86A;
    border-color: #EAEDF2;
    border-bottom: 2px solid #C9A86A;
}

QTabBar::tab:hover:!selected {
    background-color: #F0F2F5;
}

/* ===== 分组框 ===== */
QGroupBox {
    border: 1px solid #EAEDF2;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 20px;
    padding-bottom: 8px;
    padding-left: 16px;
    padding-right: 16px;
    font-weight: 600;
    color: #1E2329;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #1E2329;
    font-weight: 600;
    font-size: 14px;
}

/* ===== 复选框 ===== */
QCheckBox {
    spacing: 8px;
    color: #1E2329;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #D0D5DD;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #C9A86A;
    border-color: #C9A86A;
}

/* ===== 单选按钮 ===== */
QRadioButton {
    spacing: 8px;
    color: #1E2329;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #D0D5DD;
    border-radius: 9px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:checked {
    background-color: #C9A86A;
    border-color: #C9A86A;
}

/* ===== 数字输入 ===== */
QSpinBox, QDoubleSpinBox {
    border: 1px solid #DDE0E4;
    border-radius: 6px;
    padding: 6px 10px;
    background-color: #FFFFFF;
    color: #1E2329;
    min-height: 20px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #C9A86A;
}

/* ===== 进度条 ===== */
QProgressBar {
    border: none;
    border-radius: 4px;
    text-align: center;
    background-color: #F0F2F5;
    height: 18px;
    color: #5A6377;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #C9A86A;
    border-radius: 4px;
}

/* ===== 工具提示 ===== */
QToolTip {
    background-color: #1E2329;
    color: #F0F2F5;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ===== 对话框 ===== */
QDialog {
    background-color: #FFFFFF;
}

QDialog QLabel {
    color: #1E2329;
}

/* ===== 分割窗口 ===== */
QSplitter::handle {
    background-color: #EAEDF2;
}

/* ===== 列表/树视图 ===== */
QListView, QTreeView {
    background-color: #FFFFFF;
    border: 1px solid #EAEDF2;
    border-radius: 6px;
    alternate-background-color: #FAFBFC;
}

QListView::item:selected, QTreeView::item:selected {
    background-color: rgba(201, 168, 106, 0.10);
    color: #1E2329;
}

/* ===== 滚动区域（透明背景） ===== */
QScrollArea {
    border: none;
    background: transparent;
}