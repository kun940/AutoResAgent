DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=complaint_agent
DB_CHARSET=utf8mb4

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DASHSCOPE_API_KEY=your_cucloud_api_key_here
# v2.0: 推荐使用 QWEN_API_KEY（DASHSCOPE_API_KEY 保留为别名，二者任一配置即可）
QWEN_API_KEY=your_qwen_api_key_here

LLM_PRIMARY=deepseek
LLM_FALLBACK=qwen
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
QWEN_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
LLM_TIMEOUT_SECONDS=60

# v2.0: VLM 多模态大模型配置
VLM_ENABLED=1
VLM_TIMEOUT_SECONDS=45
VLM_MAX_IMAGES=3

CHROMA_PERSIST_DIR=./data/chroma_db
EVIDENCE_BASE_DIR=./data/evidence

FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# 必须替换为不少于 32 字符的强随机密钥（生成：python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE_HOURS=24
